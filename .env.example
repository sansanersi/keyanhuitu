# 当前 Flask 单体运行态数据库；真实运行库不要提交到 Git。
SCI_WEBAPP_DB_PATH=sci-illust-system/web_app/data/knowledge.db

# 一个 MySQL 实例下的三个逻辑库：文本库、图片库、应用平台。
SCI_MYSQL_HOST=127.0.0.1
SCI_MYSQL_PORT=3306
SCI_MYSQL_USER=root
SCI_MYSQL_PASSWORD=
SCI_TEXT_DB_NAME=text_db
SCI_IMAGE_DB_NAME=image_db
SCI_APP_DB_NAME=app_db

# 第一阶段先用本地小模型跑通 RAG / 文档 / 图片 / 生成图链路。
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:3b
SCI_MODEL_ROLLOUT_STAGE=local_small_model
