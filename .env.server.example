# 科研绘图工作台服务器部署模板
# 复制为 .env 后按服务器实际路径调整；不要提交真实 .env。

# Web 服务
SCI_WEB_MODE=stable
SCI_WEB_HOST=0.0.0.0
SCI_WEB_PORT=5000
SCI_FOCUS_DOMAIN=biology

# 运行态 SQLite 数据库；正式迁移 MySQL 前，必须把这个目录加入备份。
SCI_REPOSITORY_KIND=sqlite
SCI_WEBAPP_DB_PATH=D:\sci-illust-runtime\data\knowledge.db

# 一个 MySQL 实例下的三个逻辑库；当前是架构目标，代码仍兼容 SQLite。
SCI_MYSQL_HOST=127.0.0.1
SCI_MYSQL_PORT=3306
SCI_MYSQL_USER=sci_user
SCI_MYSQL_PASSWORD=
SCI_TEXT_DB_NAME=text_db
SCI_IMAGE_DB_NAME=image_db
SCI_APP_DB_NAME=app_db

# 本地小模型优先跑通流程，后续再切换大模型或独立模型服务。
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:0.5b
SCI_MODEL_ROLLOUT_STAGE=local_small_model

# 图标素材库路径。服务器没有 Bioicons 时，可以先指向一个空目录跑通流程。
BIOICONS_ROOT=D:\sci-illust-runtime\bioicons

# 图片库本地资产目录。后续可替换为对象存储，但服务器版 v1 先用可备份目录。
SCI_IMAGE_ASSET_ROOT=D:\sci-illust-runtime\image-assets
